---
import ContentPageLayout from '../../layouts/ContentPageLayout.astro';
import headerHtml from '../../data/homepage/header.html?raw';
import footerHtml from '../../data/homepage/footer.html?raw';
import blogMeta from '../../data/content-pages/blog-meta.json';
import page2Html from '../../data/content-pages/blog/2.html?raw';
import page3Html from '../../data/content-pages/blog/3.html?raw';

const pageHtml: Record<string, string> = {
  '2': page2Html,
  '3': page3Html,
};

export function getStaticPaths() {
  return ['2', '3'].map((page) => ({
    params: { page },
    props: { slug: `blog/${page}` as const },
  }));
}

const { slug } = Astro.props;
const page = Astro.params.page ?? '2';
const mainHtml = pageHtml[page];
const entry = blogMeta[slug as keyof typeof blogMeta];
---

<ContentPageLayout
  title={entry.title}
  description={entry.description}
  canonical={entry.canonical}
  ogImage={entry.ogImage}
  bodyClass={entry.bodyClass}
  modifiedTime={entry.modifiedTime}
  publishedTime={entry.publishedTime}
  postCss={entry.postCss}
>
  <Fragment set:html={headerHtml} />
  <Fragment set:html={mainHtml} />
  <Fragment set:html={footerHtml} />
</ContentPageLayout>
