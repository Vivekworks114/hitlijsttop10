---
const faviconBase = '/uploads/2023/03';
---

<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="icon" type="image/png" href={`${faviconBase}/cropped-favicon-32x32.png`} sizes="32x32" />
<link rel="icon" type="image/png" href={`${faviconBase}/cropped-favicon-192x192.png`} sizes="192x192" />
<link rel="apple-touch-icon" href={`${faviconBase}/cropped-favicon-180x180.png`} />
<meta name="msapplication-TileImage" content={`${faviconBase}/cropped-favicon-270x270.png`} />
